<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>orb_slam3</name>
  <version>1.0.0</version>
  <description>
    ORB-SLAM3 V1.0 packaged as a ROS 2 (ament_cmake / ament_cmake_auto) library.
    Builds the ORB-SLAM3 core shared library together with its vendored
    Thirdparty dependencies (DBoW2, g2o, Sophus) in a single colcon build and
    exports the library so downstream ROS 2 nodes can find_package(orb_slam3)
    and link against it. Tested on ROS 2 Jazzy (Ubuntu 24.04); forward-compatible
    with Kilted/Rolling. The C++ namespace remains ORB_SLAM3.
  </description>

  <maintainer email="jcameronfurey@gmail.com">J. Cameron Furey</maintainer>
  <license>GPL-3.0-only</license>
  <url type="repository">https://github.com/jcfurey/orb_slam3</url>
  <url type="website">https://github.com/UZ-SLAMLab/ORB_SLAM3</url>
  <author>Carlos Campos</author>
  <author>Richard Elvira</author>
  <author>Juan J. Gómez Rodríguez</author>
  <author>José M. M. Montiel</author>
  <author>Juan D. Tardós</author>

  <!-- Build tooling -->
  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_auto</buildtool_depend>
  <!-- Makes find_package(Eigen3) / ament_export_dependencies(Eigen3) propagate
       Eigen's include dirs to downstream (build_export so consumers get it too) -->
  <build_depend>eigen3_cmake_module</build_depend>
  <build_export_depend>eigen3_cmake_module</build_export_depend>

  <!-- System dependencies (resolvable by rosdep). These are NOT auto-found by
       ament_auto_find_build_dependencies() because their rosdep keys are not
       CMake package-config names; CMakeLists.txt find_package()es them explicitly. -->
  <depend>libopencv-dev</depend>
  <depend>eigen</depend>
  <depend>libboost-serialization-dev</depend>
  <depend>libssl-dev</depend>

  <!-- Pangolin (the viewer backend) is built when USE_PANGOLIN=ON (the default).
       It has NO rosdep key and is not packaged for Ubuntu 24.04, so it is vendored
       as an in-workspace colcon package: src/Pangolin, package name "pangolin"
       (lowercase), from stevenlovegrove/Pangolin. Depending on it here makes colcon
       build that package BEFORE orb_slam3 — find_package(Pangolin REQUIRED) needs its
       installed PangolinConfig.cmake — and, via ament_export_dependencies(Pangolin),
       propagates it to downstream find_package(orb_slam3) consumers.
       The key is the lowercase colcon package name "pangolin", NOT the CMake config
       name "Pangolin": rosdep ignores it because it lives in the workspace src/ tree.
       For a headless build (USE_PANGOLIN=OFF) the src/Pangolin package is unused.
       See ROS2.md. -->
  <depend>pangolin</depend>

  <!-- ROS 2 wrapper nodes (orb_slam3_ros/); built when ORB_SLAM3_BUILD_ROS_NODES=ON
       (the default). These do not affect downstream find_package(orb_slam3) consumers,
       which only inherit the library's exported OpenCV/Eigen/Boost/OpenSSL deps. -->
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>
  <depend>rclcpp_components</depend>
  <depend>lifecycle_msgs</depend>
  <depend>ament_index_cpp</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>diagnostic_updater</depend>
  <depend>cv_bridge</depend>
  <depend>message_filters</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_eigen</depend>
  <depend>tf2_geometry_msgs</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
